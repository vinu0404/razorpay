# Copy to .env and fill in. Never commit .env.

# Zoho data center: com | in | eu | com.au | jp | ca | sa | com.cn
ZOHO_DC=in
ZOHO_ORG_ID=your-organization-id
ZOHO_CLIENT_ID=your-client-id
ZOHO_CLIENT_SECRET=your-client-secret
ZOHO_REDIRECT_URI=http://localhost:8765/oauth/callback

# Optional settings (defaults shown). ENV=prod switches logs to JSON.
# ENV=dev
# LOG_LEVEL=INFO
# RATE_LIMIT_PER_MINUTE=90
# MAX_CONCURRENCY=5
# DAILY_REQUEST_BUDGET=900
